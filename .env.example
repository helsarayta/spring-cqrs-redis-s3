# Salin ke .env lalu sesuaikan.  `docker compose` membaca .env otomatis.
# Aplikasi Spring Boot membaca nilai-nilai ini lewat placeholder di application.yml.

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
WRITE_DB_NAME=writedb
READ_DB_NAME=readdb
DB_USER=appuser
DB_PASSWORD=apppass

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# TTL cache produk (detik)
CACHE_TTL_SECONDS=600
# Jitter acak 0..N detik ditambahkan ke TTL supaya key tidak expired serentak
CACHE_TTL_JITTER_SECONDS=60
# TTL untuk negative caching (id yang tidak ditemukan) — pendek saja
CACHE_NULL_TTL_SECONDS=30
# TTL cache hasil list/paging — pendek karena tidak di-invalidate per-id
CACHE_LIST_TTL_SECONDS=60
# Timeout operasi Redis. Kalau lewat, read-service fail-open langsung ke DB.
CACHE_TIMEOUT_MS=200

# ---------- Kafka ----------
# Dari host (aplikasi dijalankan lewat `make run-*`)
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_HOST_PORT=29092
KAFKA_UI_PORT=8090

# ---------- MinIO / S3 ----------
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_BUCKET=product-images
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# PRESIGNED = bucket private, URL bertanda tangan & kedaluwarsa (default)
# PUBLIC    = bucket public-read, URL statis dari S3_PUBLIC_BASE_URL
S3_URL_MODE=PRESIGNED
S3_PRESIGN_TTL_MINUTES=15
S3_PUBLIC_BASE_URL=http://localhost:9000
MAX_IMAGE_SIZE_MB=5

# ---------- Aplikasi ----------
WRITE_SERVICE_PORT=8081
READ_SERVICE_PORT=8082

# ---------- CORS ----------
# Kosong = tidak ada header CORS yang dikirim, browser menolak permintaan lintas-origin.
# Default aman. Isi hanya origin front-end Anda, dipisah koma.
# Ingat: CORS hanya berlaku di browser — curl dan skrip tidak terpengaruh, jadi ini
# BUKAN kontrol keamanan.
CORS_ALLOWED_ORIGINS=

# ---------- Rate limit ----------
# Dimatikan secara default. Hitungannya per-instance, bukan lintas instance: kalau service
# dijalankan 3 replika, satu klien praktis mendapat 3x jatah ini. Untuk pembatasan yang
# sungguhan, pakai API gateway atau penghitung berbasis Redis.
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
